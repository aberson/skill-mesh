{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema",
                     "registry_categories",
                     "required_projects",
                     "additional_active_projects",
                     "embedded_inactive_projects",
                     "deferred_projects",
                     "repository_overrides",
                     "repository_sources"
                 ],
    "properties":  {
                       "schema":  {
                                      "const":  "skill-mesh/production-portfolio-policy/v1"
                                  },
                       "registry_categories":  {
                                                   "type":  "array",
                                                   "uniqueItems":  true,
                                                   "minItems":  1,
                                                   "maxItems":  1,
                                                   "items":  {
                                                                 "const":  "utility"
                                                             }
                                               },
                       "required_projects":  {
                                                 "type":  "array",
                                                 "uniqueItems":  true,
                                                 "items":  {
                                                               "$ref":  "#/$defs/slug"
                                                           }
                                             },
                       "additional_active_projects":  {
                                                          "type":  "array",
                                                          "uniqueItems":  true,
                                                          "items":  {
                                                                        "$ref":  "#/$defs/slug"
                                                                    }
                                                      },
                       "embedded_inactive_projects":  {
                                                          "type":  "array",
                                                          "uniqueItems":  true,
                                                          "items":  {
                                                                        "$ref":  "#/$defs/slug"
                                                                    }
                                                      },
                       "deferred_projects":  {
                                                 "type":  "array",
                                                 "uniqueItems":  true,
                                                 "items":  {
                                                               "type":  "object",
                                                               "additionalProperties":  false,
                                                               "required":  [
                                                                                "slug",
                                                                                "reason_code",
                                                                                "evidence"
                                                                            ],
                                                               "properties":  {
                                                                                  "slug":  {
                                                                                               "$ref":  "#/$defs/slug"
                                                                                           },
                                                                                  "reason_code":  {
                                                                                                      "enum":  [
                                                                                                                   "NO_REMOTE_AND_PLACEHOLDER",
                                                                                                                   "DOCUMENTATION_ONLY",
                                                                                                                   "NO_REMOTE_AND_NOT_IMPLEMENTED"
                                                                                                               ]
                                                                                                  },
                                                                                  "evidence":  {
                                                                                                   "type":  "string",
                                                                                                   "minLength":  1
                                                                                               }
                                                                              }
                                                           }
                                             },
                       "repository_overrides":  {
                                                    "type":  "object",
                                                    "additionalProperties":  false,
                                                    "required":  [
                                                                     "dev-observatory",
                                                                     "switchboard"
                                                                 ],
                                                    "properties":  {
                                                                       "dev-observatory":  {
                                                                                               "$ref":  "#/$defs/slug"
                                                                                           },
                                                                       "switchboard":  {
                                                                                           "$ref":  "#/$defs/slug"
                                                                                       }
                                                                   }
                                                },
                       "repository_sources":  {
                                                  "type":  "array",
                                                  "minItems":  1,
                                                  "items":  {
                                                                "type":  "object",
                                                                "additionalProperties":  false,
                                                                "required":  [
                                                                                 "owner_slug",
                                                                                 "checkout_relative_path",
                                                                                 "canonical_remote_url",
                                                                                 "project_slugs",
                                                                                 "allowed_upstream_ref"
                                                                             ],
                                                                "properties":  {
                                                                                   "owner_slug":  {
                                                                                                      "$ref":  "#/$defs/slug"
                                                                                                  },
                                                                                   "checkout_relative_path":  {
                                                                                                                  "$ref":  "#/$defs/relative_path"
                                                                                                              },
                                                                                   "canonical_remote_url":  {
                                                                                                                "$ref":  "#/$defs/remote"
                                                                                                            },
                                                                                   "project_slugs":  {
                                                                                                         "type":  "array",
                                                                                                         "minItems":  1,
                                                                                                         "uniqueItems":  true,
                                                                                                         "items":  {
                                                                                                                       "$ref":  "#/$defs/slug"
                                                                                                                   }
                                                                                                     },
                                                                                   "allowed_upstream_ref":  {
                                                                                                                "$ref":  "#/$defs/ref"
                                                                                                            }
                                                                               }
                                                            }
                                              }
                   },
    "$defs":  {
                  "slug":  {
                               "type":  "string",
                               "pattern":  "^[a-z][a-z0-9_-]*$"
                           },
                  "relative_path":  {
                                        "type":  "string",
                                        "pattern":  "^[a-z0-9][a-z0-9._/-]*$"
                                    },
                  "remote":  {
                                 "type":  "string",
                                 "pattern":  "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
                             },
                  "ref":  {
                              "type":  "string",
                              "pattern":  "^origin/[A-Za-z0-9][A-Za-z0-9._/-]*$"
                          }
              }
}
