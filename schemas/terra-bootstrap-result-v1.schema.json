{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "CHANGES_REQUIRED", "BLOCKED", "INVALID"]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "path", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocker", "significant", "minor"]
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
