{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aberson/skill-mesh/schemas/companions.schema.json",
  "title": "Skill Mesh core companion manifest (config/companions.json), schema_version 1",
  "$comment": "Owner of the shape: documentation/core-companion-plan.md section 4. Checker: tools/companions.py verify, which enforces this schema plus rules a schema cannot state: members sorted by slug with unique slugs, repo naming the slug, skill-mesh caller paths existing in the tree, and (verify --release) a non-null tag for every core and optional member. Readers refuse a newer schema_version (portfolio decision P-4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "members"],
  "properties": {
    "schema_version": {"const": 1},
    "members": {
      "type": "array",
      "items": {"$ref": "#/$defs/member"}
    }
  },
  "$defs": {
    "argv": {
      "$comment": "A command line. Its first entry is a bare command name (the cli pattern: no leading -, no path, no token). The installer replaces exactly two tokens, {home} and {settings}, in the other entries; any other {...} text is refused.",
      "type": "array",
      "minItems": 1,
      "prefixItems": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}],
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:[^{}]|\\{home\\}|\\{settings\\})*$"
      }
    },
    "settings_argv": {
      "$comment": "A member hook command: it takes --settings <path>.",
      "allOf": [
        {"$ref": "#/$defs/argv"},
        {"contains": {"const": "--settings"}}
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema_version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1}
      }
    },
    "caller": {
      "$comment": "A skill-mesh repo-relative POSIX path (verify checks it exists), or member:<path> for a call site in the member's own repository (checked at the pinned tag by plan Step 11). Neither form may hold a ':' after the member: prefix, or a control character.",
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^(?:member:)?/|^member:$|/$|^[A-Za-z]:|\\\\|(?:^|/|^member:)\\.{1,2}(?:/|$)|//|^(?!member:)[^:]*:|^member:.*:|[\\u0000-\\u001f\\u007f])"}
    },
    "skills": {
      "$comment": "The member's own skill installer. The companion installer appends --host <provider>; Skill Mesh never copies those files itself.",
      "type": "object",
      "additionalProperties": false,
      "required": ["installer", "uninstaller", "names"],
      "properties": {
        "installer": {"$ref": "#/$defs/argv"},
        "uninstaller": {"$ref": "#/$defs/argv"},
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        }
      }
    },
    "setup_write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "uninstall"],
      "properties": {
        "install": {"$ref": "#/$defs/argv"},
        "uninstall": {"oneOf": [{"$ref": "#/$defs/argv"}, {"type": "null"}]}
      }
    },
    "file_hook": {
      "$comment": "kind file (tripwire): the companion copies the packaged hook file that locate prints and merges the settings entry itself (host claude: <home>/.claude/settings.json; host codex: <home>/.codex/hooks.json). verify also requires name to be unique per host within a member. timeout is in seconds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "host", "event", "matcher", "locate", "timeout"],
      "properties": {
        "kind": {"const": "file"},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "host": {"enum": ["claude", "codex"]},
        "event": {"type": "string", "minLength": 1},
        "matcher": {"type": "string", "minLength": 1},
        "locate": {"$ref": "#/$defs/argv"},
        "timeout": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    },
    "member_hook": {
      "$comment": "kind member (passing-notes): the member owns its settings entry; the companion runs these commands and records the result.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "host", "event", "install", "uninstall", "check"],
      "properties": {
        "kind": {"const": "member"},
        "host": {"enum": ["claude", "codex"]},
        "event": {"type": "string", "minLength": 1},
        "install": {"$ref": "#/$defs/settings_argv"},
        "uninstall": {"$ref": "#/$defs/settings_argv"},
        "check": {"$ref": "#/$defs/settings_argv"}
      }
    },
    "hook": {
      "oneOf": [
        {"$ref": "#/$defs/file_hook"},
        {"$ref": "#/$defs/member_hook"}
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "ring",
        "repo",
        "tag",
        "cli",
        "health",
        "contract",
        "callers",
        "skills",
        "setup_write",
        "hooks",
        "setup",
        "candidate_note"
      ],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "ring": {"enum": ["core", "optional", "candidate"]},
        "repo": {
          "oneOf": [
            {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[a-z0-9-]+$"},
            {"type": "null"}
          ]
        },
        "tag": {
          "$comment": "Null means unreleased: allowed in the tree, skipped by the installer, refused by verify --release for core and optional members.",
          "oneOf": [
            {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
            {"type": "null"}
          ]
        },
        "cli": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "health": {
          "type": "array",
          "prefixItems": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}],
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:[^{}]|\\{home\\}|\\{settings\\})*$"
          }
        },
        "contract": {"oneOf": [{"$ref": "#/$defs/contract"}, {"type": "null"}]},
        "callers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/caller"}
        },
        "skills": {"oneOf": [{"$ref": "#/$defs/skills"}, {"type": "null"}]},
        "setup_write": {"oneOf": [{"$ref": "#/$defs/setup_write"}, {"type": "null"}]},
        "hooks": {"type": "array", "items": {"$ref": "#/$defs/hook"}},
        "setup": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "candidate_note": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      },
      "if": {
        "properties": {"ring": {"enum": ["core", "optional"]}},
        "required": ["ring"]
      },
      "then": {
        "properties": {
          "repo": {"type": "string"},
          "health": {"minItems": 1},
          "contract": {"type": "object"},
          "callers": {"minItems": 1},
          "candidate_note": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "candidate_note": {"type": "string"}
        }
      }
    }
  }
}
