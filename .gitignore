# caches / build artifacts
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
node_modules/
*.db

# OS
.DS_Store
Thumbs.db

# run artifacts
tmp/

# plan-expedite resume state (one sidecar per plan, e.g.
# .plan-expedite-state.<plan-slug>-<date>). It belongs to whichever plan is being
# expedited, never to a build-phase checkpoint commit -- and build-phase's
# checkpoint runs `git add -A`, which would otherwise sweep another phase's state
# into this phase's history.
.plan-expedite-state.*
# build-step sidecars (per-step dev/reviewer reports + verdicts; may embed local paths)
.build-step/

# review-deep sidecars (per-lens verdicts + aggregated audit trail; same rationale)
.review-deep/

# generated host distributions (build-distributions.ps1 default staging output)
dist/

# release staging output + checksums (release.ps1 default staging output; never
# the committed artifact -- a fresh release is built and verified on demand)
release-stage/

# telemetry log (private per-session invocations; neutral log starts empty)
runtime/telemetry/invocations.jsonl

# generated calibration baseline (produced by tests/calibration/calibrate.py runs)
tests/calibration/calibration-baseline.json
